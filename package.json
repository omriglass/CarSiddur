{
  "name": "carshare-nevo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > src/integrations/supabase/types.ts",
    "db:new": "npx supabase migration new",
    "db:push": "npx supabase db push",
    "db:test": "docker exec -i \"$(docker ps --format '{{.Names}}' | grep '^supabase_db_')\" psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/tests/rls_smoke.sql",
    "functions:serve": "npx supabase functions serve --env-file supabase/functions/.env",
    "functions:bundle": "node scripts/bundle-solver.mjs && node supabase/tests/bundle_solver.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/supabase-js": "2.115.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.41.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.87.0",
    "react-router-dom": "6.30.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.5.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "esbuild": "0.21.5",
    "fast-check": "4.9.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "supabase": "2.116.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "5.4.21",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
