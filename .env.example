# Copy to .env.local and fill in for local development (ARCHITECTURE.md §13).
# Only VITE_* variables reach the browser; never put a service-role or
# private VAPID key in this file.

# Local Supabase stack (`npm run db:start`); use the printed values, or the
# hosted project's URL/anon key for pointing dev at a remote project.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Public VAPID key for web-push subscriptions (not a secret).
VITE_VAPID_PUBLIC_KEY=

# Absolute base URL used to build deep links in WhatsApp text (e.g. /p/<token>).
VITE_APP_URL=http://localhost:8080

# Optional: Google OAuth "Web application" client id for the EXPERIMENTAL Google
# calendar on the "my rides" week view (public, not a secret; the same client as
# Google sign-in is fine). Empty = the feature stays hidden.
VITE_GOOGLE_CLIENT_ID=
